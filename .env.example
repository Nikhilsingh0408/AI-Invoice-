# PostgreSQL credentials for the local Compose stack. Change the password before use.
POSTGRES_USER=invoice_auditor
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=invoice_auditor

# Match the account that owns the mounted invoice and report folders.
# Set these to the output of `id -u` and `id -g` on your machine.
LOCAL_UID=1000
LOCAL_GID=1000

# Amazon Bedrock settings
AWS_REGION_NAME=us-east-1
LLM_REASONING_MODEL=global.amazon.nova-2-lite-v1:0
LLM_RAG_MODEL=global.amazon.nova-2-lite-v1:0
LLM_TRANSLATION_MODEL=global.amazon.nova-2-lite-v1:0
EMBEDDING_MODEL=cohere.embed-english-v3

# Normally leave these unset and use ~/.aws/credentials.
# If you cannot mount AWS credentials, set both values here instead.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

LOG_LEVEL=INFO
